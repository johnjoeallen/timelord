# Copy to .env and adjust. Windows agents on your LAN must be able to reach
# TIMELORD_PUBLIC_URL directly — it is handed to agents during discovery and
# registration, so it must not be a Docker-internal hostname like
# "http://controller:8080".
TIMELORD_PUBLIC_URL=http://192.168.1.20:9099
# Host port the API/web UI is published on; change if 9099 is already taken.
TIMELORD_HTTP_PORT=9099
TIMELORD_CONTROLLER_NAME=Home TimeLord
TIMELORD_DISCOVERY_ENABLED=true
TIMELORD_DISCOVERY_PORT=45821
TIMELORD_ANNOUNCEMENT_ENABLED=false

# Development-only credentials. Do not reuse these outside a trusted local
# network — see the Phase 1 security warning in README.md.
POSTGRES_DB=timelord
POSTGRES_USER=timelord
POSTGRES_PASSWORD=timelord
